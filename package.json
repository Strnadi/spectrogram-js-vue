      "import": "./dist/spectrogram-vue.es.js"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b --noCheck && vite build",
    "preview": "vite preview"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/d3": "5",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.7.0",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "vite-plugin-dts": "^4.5.3",
