  "version": "0.0.3",
  "license": "MIT",
  "author": "vlandham",
  "keywords": [
    "audio",
    "processing",
    "visualization",
    "tools"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "types": "./dist/lib/index.d.ts",
  "module": "./dist/spectrogram-vue.es.js",
  "main": "./dist/spectrogram-vue.umd.js",
  "exports": {
